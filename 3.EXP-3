# Exp - 3:
Linear and Polynomial Regression
----------------------------------
import pandas as pd
df = pd.read_csv("housing.csv")
print(df.head())
print(df.shape)
print(df.columns.tolist())
-------------------------------
# selecting X and Y
target_col = 'median_house_value'
X = df.drop (columns = target_col)
Y = df[target_col]
---------------------------------
# Convert cont. to Categorial data
# Perfoem one-hot encoding [ we can do using encoding but long process]

print("Before Conversion")
print(X.head(5))

# Performs one - hot encoding
# --> drop_first deletes the first col .. becuse if other is false this 1st col will obviosuly be true
X = pd.get_dummies(X,drop_first =True)


print("After Conversion")
print(X.head(5))

--------------------------------------------------
# Handling Missing Values:
print("before handling missing values")
print(X.isnull().sum())

X['total_bedrooms'] = X['total_bedrooms'].fillna(X['total_bedrooms'].median())
X= X.astype(int)
print(X.head())

print(X.isnull().sum())
------------------------------------------------------------
# Split data set
from sklearn.model_selection import train_test_split
X_train,X_test,y_train,y_test = train_test_split(X,Y,test_size= 0.2,random_state= 42)
print(len(X_train))
print(len(X_test))
----------------------------------------------------
# Linear Regression:

from sklearn.linear_model import LinearRegression
model = LinearRegression()
model.fit(X_train,y_train)
y_pred = model.predict(X_test)

print("Actual Values")
print(y_test)

print("Predicted Values")
print(y_pred)
------------------------------------------
# Evaluation Metrics:
from sklearn.metrics import mean_absolute_error,mean_squared_error,r2_score
import numpy as np

mae = mean_absolute_error(y_test,y_pred)
mse = mean_squared_error (y_test,y_pred)
rmse = np.sqrt(mse)
r2score = r2_score(y_test,y_pred)

print ("MAE:",round(mae,2))
print("MSE:",round(mse,2))
print("RMSE:",round(rmse,2))
print("r2score:",round(r2score,4))
----------------------------------------------------------------------------
# Polynomial Regression
from sklearn.preprocessing import PolynomialFeatures
poly = PolynomialFeatures(degree = 2, include_bias = False)
# square input features 
X_train_poly = poly.fit_transform(X_train)
X_test_poly = poly.fit_transform(X_test)

model = LinearRegression()
model.fit(X_train_poly,y_train)

y_pred_poly = model.predict (X_test_poly)

print("Actual Values:")
print(y_test[:10])

print("Predicted:")
print(y_pred[:10])
----------------------------------------------------------------
mae1 = mean_absolute_error(y_test,y_pred_poly)
mse2 = mean_squared_error (y_test,y_pred_poly)
rmse2 = np.sqrt(mse)
r2score2 = r2_score(y_test,y_pred_poly)

print ("MAE:",round(mae,2))
print("MSE:",round(mse,2))
print("RMSE:",round(rmse,2))
print("r2score:",round(r2score,4))
---------------------------------------------------------
# comparisin table

comparision = pd.DataFrame ( 
    {
        'metrics' : ['MAE','MSE','RMSE','R2'],
        'LinearRegression' : [mae,mse,rmse,r2score],
        'Poly': [mae2,mse2,rmse2,r2score2]
    }
)
print(comparision.round(2))
---------------------------------------------------
# Linear scatter
import matplotlib.pyplot as plt

plt.scatter(y_test,y_pred,alpha = 0.5)
plt.show()
-------------------------------------------
# poly sactter
plt.scatter(y_test,y_pred_poly,alpha  = 0.5)
plt.show()
-------------------------------------------
# results
results = pd.DataFrame (
    {
        'Actual': y_test.values,
        'Linear': y_pred,
        'Poly' : y_pred_poly
    })
print(results.head())
