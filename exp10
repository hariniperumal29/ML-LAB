import pandas as pd
import numpy as np 
import matplotlib.pyplot as plt

from sklearn.preprocessing import LabelEncoder
from sklearn.preprocessing import StandardScaler

from sklearn.cluster import KMeans
from sklearn.decomposition import PCA

df = pd.read_csv("Mall_Customers.csv")
print(df.head())
print(df.shape)
print(df.isnull().sum())
print(df.columns.tolist())

if 'Gender' in df.columns:
    encoder = LabelEncoder()
    df['Gender'] = encoder.fit_transform(df['Gender'])

    X = df.drop('CustomerID',axis = 1)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

wcss = []
for i in range(1,11):
    kmeans = KMeans(n_clusters = i,random_state = 42,n_init = 10)
    kmeans.fit(X_scaled)
    wcss.append(kmeans.inertia_)

    plt.plot(range(1,11),wcss,marker='o')
plt.show()

kmeans = KMeans(n_clusters = 5,random_state = 42,n_init= 10)
clusters  =kmeans.fit_predict(X_scaled)
df['clustes'] = clusters
print(df.head)

pca = PCA(n_components = 2)
principal_componenets = pca.fit_transform (X_scaled)
pca_df = pd.DataFrame(principal_componenets,columns= ['pca1','pca2'])
pca_df['clustes']=clusters
print(pca_df.head())

plt.figure(figsize=(5,6))
for i in sorted(pca_df['clustes'].unique()):
    s = pca_df[pca_df['clustes'] == i]
    plt.scatter(s['pca1'],s['pca2'],label= f'cluster{i}')
    plt.legend()

    summary = df.groupby('clustes').mean()
print(summary)


df.to_csv("cluster.csv",index=False)
