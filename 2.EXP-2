EXP -2 Feature Selection and Engg
----------------------------------
import pandas as pd
# Loading dataset 
df = pd.read_csv("titanic.csv")
print(df.head())
-----------------------------------------------------------

# Handling missing values:

# filling age and Fare with median
# Embarked with mode
if 'Age' in df.columns:
    df['Age'] = df['Age'].fillna(df['Age'].median())

if 'Fare' in df.columns:
    df['Fare'] = df['Fare'].fillna(df['Fare'].median())

if 'Embarked' in df.columns:
    df['Embarked'] = df['Embarked'].fillna(df['Embarked'].mode()[0])

------------------------------------------------------------------------

#Feature Engineering: Creating or transforming features.
#Feature Selection: Choosing the most useful features from existing ones.

import numpy as np

# Feature Engineering:

# (i) Creating feature called Family size = 1 + SibSp + Parch

df['FamilySize'] = df['SibSp'] + df['Parch'] + 1
-------------------------------------------------

# (ii)  AgeGroup : dividing age into groups
# labels: 0 -12 : 0 
         #12-18 :1
df['AgeGroup'] = pd.cut( 
                        df['Age'],
                        bins = [0,12,18,35,60,100],
                        labels = [0,1,2,3,4]
)
-----------------------------------------------

# (iii) Is Alone

df['IsAlone'] = np.where(df['FamilySize'] ==1,1,0)
-------------------------------------------------

# (iv) Replacing : Mlle /Ms => Miss or Mme => mr

df['Title'] = df['Name'].str.extract('([A-Za-z]+)\.',expand =False)
# [] --> indicates range from [A-Za-z] 
# + --> contain more than one alphabet
# \. matches . 
# expand = FALSE : means return series 
# true means returns data frame


rare_titles = ['Lady','Sir','Don','Dona','Dr','Countess','Capt','Col','Major','Rev','Jonkheer']
df['Title'] = df['Title'].replace(rare_titles,'Rare')
df['Title'] = df['Title'].replace(['Mlle','Ms'],'Miss')
df['Title'] = df['Title'].replace('Mme','Mrs')
------------------------------------------------------------------------------------------------

# Label Encoding 
# --> Sex, Embarked, Title

from sklearn.preprocessing import LabelEncoder
encoder = LabelEncoder()

df['Sex'] = encoder.fit_transform(df['Sex'])
df['Embarked'] = encoder.fit_transform(df['Embarked'])
df['Title'] = encoder.fit_transform(df['Title'])
----------------------------------------------------------
# Converting type of AgeGroup to int

df['AgeGroup'] = df['AgeGroup'].astype(int)
-------------------------------------------------------
# Selecting X and Y

features = ['Age','Fare','Embarked','Sex','FamilySize','IsAlone','AgeGroup','Title','Pclass']
X = df[features]
Y= df['Survived']
---------------------------------------------------------------------------------------------------
# Selecting best features

from sklearn.feature_selection import SelectKBest,chi2

# creating obj
# synatx : SelectKBest(score_func= method_name,k = no_of_features to select)
selector = SelectKBest(score_func=chi2,k=5)

# fit : find relationshi pb/w x and y 
# tranform: eleimnates other chooisng relevant features
# returns only value [ no col name]
X_features = selector.fit_transform(X,Y)

# to extract column name:
selected_features = X.columns[selector.get_support()]
# --> selector.get_support() : returns true or false for each feature
# X.columns : select onnly thos featue whose value is true

# Printing Selected Features:
print(selected_features.tolist())
--------------------------------------------------------------------------------------------------
# Printing scores:

scores = pd.DataFrame(
    {
        'Features':X.columns,
        'Score':selector.scores_
    }
)
print(scores.sort_values(by = 'Score',ascending = False))
--------------------------------------------------------------------------------------------
# Spliting data set
from sklearn.model_selection import train_test_split
X_train,X_test,y_train,y_test = train_test_split(X[selected_features],Y,test_size  = 0.2,random_state= 42)
-----------------------------------------------------------------------------------------------------------
# model
from sklearn.ensemble import RandomForestClassifier
model  = RandomForestClassifier()
# n_estimators =100 default : it gives number of decison tree to use
model.fit(X_train,y_train)

-----------------------------------------------------------
y_pred = model.predict(X_test)
from sklearn.metrics import accuracy_score
accuracy = accuracy_score(y_test,y_pred)
print(round (accuracy *100,2))
